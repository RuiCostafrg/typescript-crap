 "decisions": {
  "D1": "Kept. Paired median saving 0.55 s (macOS), 0.57 s (Ubuntu), 0.67 s (Windows) per install; head faster in 31-36 of 40 pairs per runner.",
  "D3": "Skipped. The .sha256 sidecar adds 0.03-0.05 s (median) to the download on every runner, under the 0.2 s threshold; gh fetches the assets concurrently. --format json --jq adds no measurable verify time, so a name-bound attested-digest check stays possible as a separate hardening change.",
  "D4": "Dropped. See d4_tuf_cache."
 },
 "d2_dist_sizes_bytes": {
  "run": "https://github.com/RuiCostafrg/typescript-crap/actions/runs/43539860193",
  "method": "cargo build --locked --profile dist --target T on the release runner OS, first with CARGO_PROFILE_DIST_STRIP=debuginfo (before), then the new default; archive = tar -cJf of the release file set (binary, LICENSE, README.md, CHANGELOG.md, plus musl-COPYRIGHT on Linux). The before build reproduces the published v2.4.0 x86_64 musl binary size within 80 bytes (published 7123640).",
  "x86_64-unknown-linux-musl": {
   "binary_before": 7123560,
   "binary_after": 6546888,
   "archive_before": 1419656,
   "archive_after": 1312688
  },
  "aarch64-unknown-linux-musl": {
   "binary_before": 6712808,
   "binary_after": 5837640,
   "archive_before": 1245900,
   "archive_after": 1117932
  },
  "aarch64-apple-darwin": {
   "binary_before": 6249424,
   "binary_after": 5766752,
   "archive_before": 1167208,
   "archive_after": 1081820
  },
  "x86_64-pc-windows-msvc": "not measured; MSVC binaries keep symbols in a separate PDB that is not shipped"
 },
 "d4_tuf_cache": {
  "location": "$XDG_CACHE_HOME/gh/.sigstore/root (default ~/.cache/gh/.sigstore/root): tuf-repo-cdn.sigstore.dev/ and tuf-repo.github.com/, each with root, timestamp, snapshot and targets metadata plus targets/trusted_root.json, and a <repo>.json file holding lastTimestamp.",
  "freshness": "With a populated cache and the network blocked (HTTPS_PROXY to a closed port), gh 2.95.0 fails with 'tuf refresh failed: Get https://tuf-repo-cdn.sigstore.dev/15.root.json', so it refreshes against Sigstore on every run; a warm run on hosted gh 2.103.3 still takes 2.6-3.2 s, consistent with a network refresh.",
  "saving_hosted_median_s": {
   "ubuntu-26.04": [
    3.093,
    2.629
   ],
   "macos-26": [
    3.374,
    3.096
   ],
   "windows-2022": [
    3.394,
    3.17
   ]
  },
  "decision": "Dropped. A warm cache saves only 0.2-0.5 s, about what an actions/cache restore round trip costs, plus a save step and the caller's cache quota. Restoring the directory would also make a cache entry, writable by other workflow runs in the repository, the TUF trust anchor instead of the root embedded in gh; that is a cache keyed by what the cache supplies."
 }
}
