{
 "summary": "Per-step timing of the GitHub Action install path on GitHub-hosted runners (D0), the paired effect of fetching the Sigstore trusted root during the download (D1), dist-profile binary sizes with strip = \"symbols\" (D2), and the TUF cache investigation (D4). Seconds are wall time from Python perf_counter around each subprocess; every iteration starts gh with an empty XDG_CACHE_HOME, as on a fresh hosted VM.",
 "date": "2026-11-14",
 "release_measured": "2.4.0",
 "harness": "Temporary .github/d0/measure_install.py and .github/workflows/d0-install-timing.yml on PR #76 (removed before merge). 2 VMs x 5 iterations per runner; the paired block runs main's and the PR's action/install.sh alternately, 4 pairs per iteration, alternating which goes first.",
 "how_to_read": {
  "download_archive_and_sidecar": "gh release download of the archive and its .sha256 (what the Action does)",
  "download_archive_only": "the same without the sidecar (D3 saving = difference)",
  "trusted_root_cold": "gh attestation trusted-root with an empty TUF cache",
  "trusted_root_warm": "the same right after, with the TUF cache populated (D4 upper bound)",
  "verify_archive": "gh attestation verify with --custom-trusted-root and the exact identity flags",
  "verify_archive_json": "the same with --format json --jq selecting the archive's named subject digest",
  "overlap_download_and_root_wall": "download and trusted-root started together, until both finish",
  "install_sh_total": "action/install.sh end to end from the checkout under test",
  "paired_install_sh": "main's install.sh (base, serial) against the PR's (head, D1); head_minus_base_median is the median per-pair difference",
  "npm_install": "npm install --save-exact typescript-crap@2.4.0 into an empty project with an empty npm cache",
  "shell_installer": "curl ... /v2.4.0/ts-crap-installer.sh | sh with TS_CRAP_UNMANAGED_INSTALL"
 },
