{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RuiCostafrg/typescript-crap/main/schemas/config-v1.schema.json",
  "title": "ts-crap project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|\\\\|(^|/)\\.\\.(/|(?![\\s\\S])))"
        },
        "description": "Root-relative glob, compiled and additionally validated by globset at runtime."
      },
      "default": []
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^/|\\\\|(^|/)\\.\\.(/|(?![\\s\\S])))"
        },
        "description": "Root-relative glob, compiled and additionally validated by globset at runtime."
      },
      "default": []
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308,
      "default": 10
    },
    "require_coverage": {
      "type": "boolean",
      "default": false
    },
    "fail_on_empty": {
      "type": "boolean",
      "default": false
    },
    "excluded_directories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(^\\.{1,2}$|[/\\\\\\u0000])"
        },
        "description": "One directory name (a single path component) skipped anywhere under the root."
      },
      "default": [
        "node_modules",
        ".git",
        "target",
        "dist",
        "build",
        "coverage"
      ],
      "description": "Replaces the default excluded directory names for scanning and coverage collection. Requires ts-crap 2.4.0 or later."
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings for --mutation-report; validated but ignored without it.",
      "properties": {
        "equivalent": {
          "type": "array",
          "description": "Reviewed acknowledgments of surviving mutants that cannot change behaviour. An entry matches a `survived` mutant (never no-coverage) owned by the function with this identity whose operator, original and replacement are byte-equal. Duplicate entries are an error.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "identity",
              "operator",
              "original",
              "replacement",
              "reason"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path",
                "description": "Normalized root-relative forward-slash source path, as in the report."
              },
              "identity": {
                "$ref": "#/$defs/sha256",
                "description": "Function identity, as in functions[].identity of the JSON report."
              },
              "operator": {
                "type": "string"
              },
              "original": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "pattern": "\\S",
                "description": "Human justification; must not be blank."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\\\:]"
          }
        },
        {
          "not": {
            "pattern": "(^/|/(?![\\s\\S])|//|(^|/)\\.{1,2}(/|(?![\\s\\S])))"
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
